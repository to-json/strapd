#!/bin/bash

# strapd:summary=Apply strapd system setup in the installed target
# strapd:group=apply
# strapd:requires-sudo=true
# strapd:examples=strapd apply system --install-user ada --first-install
# strapd:hidden=true

set -euo pipefail

usage() {
  cat <<USAGE
Usage: strapd apply system --install-user USER [--first-install|--upgrade]
       strapd apply system --defer-provisioning --first-install

Runs root-owned strapd system setup. The ISO calls this in the target chroot
after packages are installed and the target user exists. It also calls
strapd-apply-hardware, so hardware setup cannot be accidentally skipped.

--defer-provisioning runs without an install user: deferred-provisioning installs create the user at
first boot, so scripts that grant group memberships record them in
/var/lib/strapd/provisioning/groups instead of calling usermod.
USAGE
}

install_user="${STRAPD_INSTALL_USER:-}"
first_install=0
upgrade=0
defer_provisioning=0

while (($#)); do
  case "$1" in
    --install-user)
      install_user="${2:-}"
      shift 2
      ;;
    --defer-provisioning)
      defer_provisioning=1
      shift
      ;;
    --first-install)
      first_install=1
      shift
      ;;
    --upgrade)
      upgrade=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      usage >&2
      exit 1
      ;;
  esac
done

if (( EUID != 0 )); then
  echo "Error: strapd-apply-system must run as root" >&2
  exit 1
fi

if (( defer_provisioning )); then
  install_user=""
else
  if [[ -z $install_user || $install_user == "root" ]]; then
    echo "Error: --install-user must name the target non-root user" >&2
    exit 1
  fi

  if ! getent passwd "$install_user" >/dev/null; then
    echo "Error: user '$install_user' does not exist" >&2
    exit 1
  fi
fi

export STRAPD_INSTALL_USER="$install_user"
export STRAPD_FIRST_INSTALL="$first_install"
export STRAPD_UPGRADE="$upgrade"
export STRAPD_PATH="${STRAPD_PATH:-/usr/share/strapd}"
export STRAPD_INSTALL="${STRAPD_INSTALL:-$STRAPD_PATH/install}"
export STRAPD_INSTALL_LOG_FILE="${STRAPD_INSTALL_LOG_FILE:-/var/log/strapd-install.log}"
export PATH="$STRAPD_PATH/bin:$PATH"

source "$STRAPD_INSTALL/helpers/logging.sh"
start_install_log

source "$STRAPD_INSTALL/config/all.sh"

if (( defer_provisioning )); then
  strapd-apply-hardware --defer-provisioning
else
  strapd-apply-hardware --install-user "$install_user"
fi

source "$STRAPD_INSTALL/login/all.sh"
source "$STRAPD_INSTALL/post-install/all.sh"

stop_install_log
