#!/bin/bash
#
# strapd's installer, as run from the live ISO.
#
# install.sh puts strapd onto a machine that already runs Arch. This puts Arch
# there first -- partition, pacstrap, bootloader, user -- and then hands over to
# exactly the same two steps install.sh uses, so both routes arrive at one
# description of what a strapd system is.
#
# Everything is asked before anything is written, and nothing is written until
# the disk is confirmed by name: a wrong answer to the disk question is the only
# unrecoverable mistake available here.

set -euo pipefail

REPO=${STRAPD_ISO_REPO:-/usr/share/strapd}

# Both kernels, deliberately: this installs onto hardware nobody has tested it
# on, and the failure it most needs to survive is a kernel regression against
# some particular laptop's wifi or panel. linux-lts is the difference between
# "boot the other one" and "find another computer".
KERNELS=(linux linux-lts)

# Both microcodes. Only the one matching the CPU is loaded, and getting it wrong
# costs stability on exactly the machines that are hardest to debug.
BASE_EXTRA=(
  base base-devel linux-firmware
  btrfs-progs limine snapper dosfstools
  pipewire pipewire-alsa pipewire-jack pipewire-pulse gst-plugin-pipewire libpulse
  qt6-wayland egl-wayland gtk4-layer-shell webp-pixbuf-loader
  zram-generator dkms autoconf-archive
  sudo openssh networkmanager
  intel-ucode amd-ucode
)

step() { printf '\n\033[1;32m==> %s\033[0m\n' "$*"; }
warn() { printf '\033[1;33m    %s\033[0m\n' "$*"; }
die()  { printf '\n\033[1;31mstrapd-install: %s\033[0m\n' "$*" >&2; exit 1; }

ask() {
  local prompt="$1" default="${2:-}" reply
  if [[ -n $default ]]; then
    read -rp "$prompt [$default]: " reply
    printf '%s' "${reply:-$default}"
  else
    read -rp "$prompt: " reply
    printf '%s' "$reply"
  fi
}

(( EUID == 0 )) || die "run as root (you already are on the live ISO)"

[[ -d $REPO ]] || die "no strapd tree at $REPO"

# UEFI only, said up front rather than discovered at the bootloader step with
# the disk already erased. A BIOS-only install would need a different bootloader
# layout and is not something to find out about after pacstrap.
[[ -d /sys/firmware/efi ]] ||
  die "this machine booted in BIOS/legacy mode, and strapd installs UEFI only.
    Reboot and select the UEFI entry for this USB stick in your firmware's
    boot menu, then run this again."

for tool in pacstrap arch-chroot sgdisk mkfs.btrfs mkfs.fat blkid; do
  command -v "$tool" >/dev/null || die "$tool is missing from this ISO"
done

step "Checking the network"
if ! curl -fsS --max-time 10 https://archlinux.org/ >/dev/null 2>&1; then
  cat >&2 <<'NONET'

strapd-install: no network, and the install downloads its packages.

  Wired:    it should already work; check the cable.
  Wi-Fi:    iwctl
              station wlan0 scan
              station wlan0 get-networks
              station wlan0 connect YOUR-SSID
              exit

Then run strapd-install again.
NONET
  exit 1
fi

step "Choosing a disk"
echo
lsblk -dpno NAME,SIZE,MODEL,TRAN | grep -vE 'loop|/dev/sr' || true
echo

target_disk=$(ask "Which disk should strapd be installed to? (e.g. /dev/nvme0n1)")
[[ -b $target_disk ]] || die "$target_disk is not a block device"

# The live media is a block device too, and it is mounted. Installing onto it
# would destroy the installer mid-install.
if lsblk -no MOUNTPOINTS "$target_disk" 2>/dev/null | grep -qE '/run/archiso|^/$'; then
  die "$target_disk is the live medium you booted from"
fi

echo
warn "EVERYTHING on $target_disk will be erased:"
lsblk -no NAME,SIZE,FSTYPE,LABEL "$target_disk" | sed 's/^/    /'
echo
confirmed=$(ask "Type the disk path again to confirm")
[[ $confirmed == "$target_disk" ]] || die "that did not match; nothing was changed"

step "A few details"
hostname=$(ask "Hostname" "strapd")
username=$(ask "Your username")
[[ $username =~ ^[a-z_][a-z0-9_-]*$ ]] || die "'$username' is not a valid Linux username"
[[ $username != root ]] || die "pick a name other than root; strapd sets up a user session"

while :; do
  read -rsp "Password for $username (also used for root): " password; echo
  read -rsp "Again: " password_again; echo
  [[ -n $password ]] || { warn "empty password; try again"; continue; }
  [[ $password == "$password_again" ]] && break
  warn "they did not match; try again"
done

timezone=$(ask "Timezone" "$(curl -fsS --max-time 5 https://ipapi.co/timezone 2>/dev/null || echo UTC)")
[[ -f /usr/share/zoneinfo/$timezone ]] || die "no timezone called '$timezone'"
keymap=$(ask "Console keymap" "us")

step "Partitioning $target_disk"
wipefs -a "$target_disk"
sgdisk --zap-all "$target_disk"
sgdisk -n1:0:+1G -t1:ef00 -c1:ESP "$target_disk"
sgdisk -n2:0:0   -t2:8300 -c2:strapd "$target_disk"
partprobe "$target_disk"
udevadm settle

# nvme0n1p1 rather than nvme0n11: NVMe and mmc number their partitions with a
# `p` and SATA does not, and getting this wrong formats nothing and then fails.
if [[ $target_disk =~ [0-9]$ ]]; then
  esp="${target_disk}p1"; root_part="${target_disk}p2"
else
  esp="${target_disk}1";  root_part="${target_disk}2"
fi
[[ -b $esp && -b $root_part ]] || die "the new partitions did not appear ($esp, $root_part)"

step "Making filesystems"
mkfs.fat -F32 -n ESP "$esp"
mkfs.btrfs -f -L strapd "$root_part"

# @var_log and @var_cache_pacman_pkg stay out of snapshots so a rollback does
# not take the journal and package cache back with it. @snapshots is
# deliberately absent: snapper's create-config makes .snapshots itself and
# refuses outright if the subvolume is already there.
step "Creating btrfs subvolumes"
mount "$root_part" /mnt
for subvol in @ @home @var_log @var_cache_pacman_pkg; do
  btrfs subvolume create "/mnt/$subvol"
done
umount /mnt

step "Mounting"
opts="noatime,compress=zstd:1,ssd,space_cache=v2"
mount -o "$opts,subvol=@" "$root_part" /mnt
mkdir -p /mnt/{boot,home,var/log,var/cache/pacman/pkg}
mount -o "$opts,subvol=@home"                 "$root_part" /mnt/home
mount -o "$opts,subvol=@var_log"              "$root_part" /mnt/var/log
mount -o "$opts,subvol=@var_cache_pacman_pkg" "$root_part" /mnt/var/cache/pacman/pkg
mount "$esp" /mnt/boot

step "Reading strapd's package list"
mapfile -t base_packages < <(grep -vE '^[[:space:]]*(#|$)' "$REPO/install/strapd-base.packages")
(( ${#base_packages[@]} )) || die "install/strapd-base.packages lists nothing"

# A slow or distant mirror otherwise trips pacman's low-speed abort partway
# through a couple of gigabytes, which looks like a broken install and is not.
grep -q '^DisableDownloadTimeout' /etc/pacman.conf ||
  sed -i '/^\[options\]/a DisableDownloadTimeout' /etc/pacman.conf

step "Installing $(( ${#base_packages[@]} + ${#BASE_EXTRA[@]} + ${#KERNELS[@]} )) packages; this is the long part"
pacstrap -K /mnt "${KERNELS[@]}" "${BASE_EXTRA[@]}" "${base_packages[@]}"

genfstab -U /mnt >>/mnt/etc/fstab

step "Base system configuration"
arch-chroot /mnt /bin/bash -euo pipefail <<CHROOT
ln -sf "/usr/share/zoneinfo/$timezone" /etc/localtime
hwclock --systohc
sed -i 's/^#en_US.UTF-8 UTF-8/en_US.UTF-8 UTF-8/' /etc/locale.gen
locale-gen
echo 'LANG=en_US.UTF-8' >/etc/locale.conf
echo 'KEYMAP=$keymap' >/etc/vconsole.conf
echo '$hostname' >/etc/hostname
mkinitcpio -P
id -u '$username' >/dev/null 2>&1 || useradd -m -G wheel -s /bin/bash '$username'
echo '%wheel ALL=(ALL:ALL) ALL' >/etc/sudoers.d/10-wheel
chmod 0440 /etc/sudoers.d/10-wheel
systemctl enable NetworkManager.service
CHROOT

# Through a pipe rather than the heredoc above, so the password is never
# expanded into a script body that a failure could echo.
printf '%s:%s\n%s:%s\n' "$username" "$password" root "$password" |
  arch-chroot /mnt chpasswd

step "Installing strapd"
bash "$REPO/install/place-tree.sh" --root /mnt --from "$REPO"

# The user was created before the tree was placed, so /etc/skel was empty when
# useradd copied it. This user is seconds old; there is nothing of theirs to
# overwrite.
arch-chroot /mnt cp -a /etc/skel/. "/home/$username/"
arch-chroot /mnt chown -R "$username:$username" "/home/$username"

step "Bootloader"
root_uuid=$(blkid -s UUID -o value "$root_part")
mkdir -p /mnt/boot/EFI/BOOT
cp /mnt/usr/share/limine/BOOTX64.EFI /mnt/boot/EFI/BOOT/BOOTX64.EFI

# One entry per kernel, plus a safe-graphics entry. The third is the one that
# matters on hardware nobody has tried: `nomodeset` gets a machine whose GPU the
# kernel cannot drive as far as a console, which is where it can be fixed.
{
  cat <<CONF
timeout: 3
interface_branding: strapd
term_background: 2d353b
term_foreground: d3c6aa

CONF
  for kernel in "${KERNELS[@]}"; do
    label="strapd"
    [[ $kernel == linux-lts ]] && label="strapd (LTS kernel)"
    cat <<CONF
/$label
    protocol: linux
    kernel_path: boot():/vmlinuz-$kernel
    kernel_cmdline: root=UUID=$root_uuid rw rootflags=subvol=@ quiet
    module_path: boot():/intel-ucode.img
    module_path: boot():/amd-ucode.img
    module_path: boot():/initramfs-$kernel.img

CONF
  done
  cat <<CONF
/strapd (safe graphics)
    protocol: linux
    kernel_path: boot():/vmlinuz-${KERNELS[0]}
    kernel_cmdline: root=UUID=$root_uuid rw rootflags=subvol=@ nomodeset
    module_path: boot():/intel-ucode.img
    module_path: boot():/amd-ucode.img
    module_path: boot():/initramfs-${KERNELS[0]}.img
CONF
} >/mnt/boot/limine.conf

# A firmware boot entry as well as the removable fallback path. Some firmware
# will not boot EFI/BOOT/BOOTX64.EFI unless there is nothing else; some will not
# boot anything that is not in its own list.
if command -v efibootmgr >/dev/null; then
  efibootmgr --create --disk "$target_disk" --part 1 \
    --loader '\EFI\BOOT\BOOTX64.EFI' --label 'strapd' >/dev/null 2>&1 ||
    warn "could not add a firmware boot entry; the removable fallback path is in place"
fi

# The same entry point install.sh calls: hardware detection, services, firewall,
# snapshots and the login screen.
step "Running strapd's system setup"
arch-chroot /mnt env STRAPD_PATH=/usr/share/strapd \
  /usr/share/strapd/bin/strapd-apply-system --install-user "$username" --first-install

step "Done"
cat <<DONE

strapd is installed on $target_disk.

  reboot        and remove the USB stick when the screen goes black

At the login screen pick strapd (Niri), strapd (Sway) or strapd (MangoWC).
If the machine does not reach a desktop, choose "strapd (LTS kernel)" or
"strapd (safe graphics)" in the boot menu; both are already there.

DONE
