#!/bin/bash

# strapd:summary=Set the Plymouth boot theme from an strapd theme
# strapd:args=<theme-name>
# strapd:requires-sudo=true

if (( $# != 1 )); then
  echo "Usage: strapd-plymouth-set-by-theme <theme-name>" >&2
  exit 1
fi

theme=$1

theme_dir=$(strapd-theme-dir "$theme")

theme_color() {
  local key="$1"
  local fallback="$2"

  awk -F= -v key="$key" -v fallback="$fallback" '
    function clean(raw) {
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", raw)
      if (raw ~ /^"/) {
        sub(/^"/, "", raw)
        sub(/".*$/, "", raw)
      }
      return raw
    }

    {
      field = $1
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", field)
      if (field == key) {
        print clean($2)
        found = 1
        exit
      }
      if (field == fallback) fallback_value = clean($2)
    }

    END {
      if (!found && fallback_value != "") print fallback_value
    }
  ' "$theme_dir/colors.toml"
}

bg=$(theme_color background)
text=$(theme_color foreground)

exec strapd-plymouth-set "$bg" "$text" "$theme_dir/unlock.png"
