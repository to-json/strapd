#!/bin/bash

# strapd:summary=Overwrite the user config for the Plymouth drive decryption and boot sequence with the strapd default and rebuild it.
# strapd:requires-sudo=true

sudo cp -r "$STRAPD_PATH/default/plymouth/." /usr/share/plymouth/themes/strapd/
sudo plymouth-set-default-theme strapd

if strapd-cmd-present limine-mkinitcpio; then
  sudo limine-mkinitcpio
else
  sudo mkinitcpio -P
fi
