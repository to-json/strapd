#!/bin/bash

# strapd:summary=Install a Nerd Font package and switch the system to it
# strapd:args=<display-name> <package> <family>
# strapd:examples=strapd install font 'Cascadia Mono' ttf-cascadia-mono-nerd 'CaskaydiaMono Nerd Font'

name="${1-}"
package="${2-}"
family="${3-}"

if [[ -z $name || -z $package || -z $family ]]; then
  echo "Usage: strapd-install-font <display-name> <package> <family>" >&2
  exit 1
fi

exec strapd-launch-floating-terminal-with-presentation \
  "echo 'Installing ${name}...'; strapd-pkg-add ${package} && sleep 2 && strapd-font-set '${family}'"
