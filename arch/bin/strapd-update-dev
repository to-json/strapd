#!/bin/bash

# strapd:summary=Update the active strapd dev checkout

set -euo pipefail

[[ $STRAPD_PATH != "/usr/share/strapd" ]] || exit 0

if ! git -C "$STRAPD_PATH" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  echo "Error: STRAPD_PATH is not a git checkout: $STRAPD_PATH" >&2
  exit 1
fi

upstream=$(git -C "$STRAPD_PATH" rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null || true)
if [[ -z $upstream ]]; then
  echo -e "\e[33m\nSkip strapd dev checkout update (current branch has no upstream)\e[0m"
  exit 0
fi

echo -e "\e[32m\nUpdate strapd dev checkout\e[0m"
git -C "$STRAPD_PATH" pull --ff-only
