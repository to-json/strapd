#!/bin/bash

# strapd:summary=Show which theme is styling the Plymouth boot screen
# strapd:examples=strapd plymouth current

# strapd-plymouth-set installs the theme's unlock.png as a byte-for-byte
# copy of logo.png, so matching it back identifies the current theme.
installed_logo=/usr/share/plymouth/themes/strapd/logo.png

if cmp -s "$STRAPD_PATH/default/plymouth/logo.png" "$installed_logo"; then
  echo default
  exit
fi

strapd-plymouth-list | while read -r name; do
  if cmp -s "$(strapd-theme-dir "$name")/unlock.png" "$installed_logo"; then
    echo "$name"
    exit
  fi
done
