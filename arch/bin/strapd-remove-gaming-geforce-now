#!/bin/bash

# strapd:summary=Remove the GeForce NOW Flatpak app and its data.
# strapd:group=remove
# strapd:name=gaming geforce-now

set -e

if strapd-cmd-present flatpak && flatpak info com.nvidia.geforcenow &>/dev/null; then
  flatpak uninstall -y --delete-data com.nvidia.geforcenow
fi

echo ""
echo "GeForce NOW removed."
