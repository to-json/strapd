#!/bin/bash

# strapd:summary=Remove fingerprint authentication from sudo, polkit, and lock screen
# strapd:requires-sudo=true

set -e

remove_pam_config() {
  # The fingerprint module and its clamshell gate.
  if grep -Eq 'pam_fprintd\.so|strapd-hw-laptop-closed' /etc/pam.d/sudo; then
    echo "Removing fingerprint authentication from sudo..."
    sudo sed -i -e '/pam_fprintd\.so/d' -e '/strapd-hw-laptop-closed/d' /etc/pam.d/sudo
  fi

  if [[ -f /etc/pam.d/polkit-1 ]] && grep -Eq 'pam_fprintd\.so|strapd-hw-laptop-closed' /etc/pam.d/polkit-1; then
    echo "Removing fingerprint authentication from polkit..."
    sudo sed -i -e '/pam_fprintd\.so/d' -e '/strapd-hw-laptop-closed/d' /etc/pam.d/polkit-1
  fi
}

remove_lock_fingerprint_pam() {
  if [[ -f /etc/pam.d/strapd-lock-fingerprint ]]; then
    echo "Removing lock screen fingerprint authentication..."
    sudo rm -f /etc/pam.d/strapd-lock-fingerprint
  fi
}

echo -e "\e[32mRemoving fingerprint scanner from authentication.\n\e[0m"

remove_pam_config
remove_lock_fingerprint_pam

echo "Removing fingerprint packages..."
strapd-pkg-drop fprintd libfprint libfprint-git

echo -e "\e[32mFingerprint authentication has been completely removed.\e[0m"
