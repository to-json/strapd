#!/bin/bash

# strapd:summary=Install the Tailscale mesh VPN service and a web app for the Tailscale Admin Console.
# strapd:requires-sudo=true

echo -e "\nInstalling Tailscale..."
strapd-pkg-add tailscale

echo -e "\nStarting Tailscale..."
sudo systemctl enable --now tailscaled.service
sudo tailscale up --accept-routes

echo -e "\nAllowing $USER to manage Tailscale..."
sudo tailscale set --operator="$USER"

echo -e "\nReceiving Taildrop files in $HOME/Downloads..."
systemctl --user enable --now strapd-tailscale-receive.service

echo -e "\nAdding Tailscale to the bar..."
strapd-plugin-enable strapd.tailscale

strapd-webapp-install "Tailscale" "https://login.tailscale.com/admin/machines" https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/png/tailscale-light.png
