#!/bin/bash

# strapd:summary=Set the strapd package channel.
# strapd:args=<stable|rc|edge|dev>
# strapd:requires-sudo=true

set -euo pipefail

usage() { echo "Usage: strapd-channel-set [stable|rc|edge|dev]"; }
fail() { echo "Error: $*" >&2; exit 1; }

confirm_dev() {
  cat <<'WARNING'

The dev channel links strapd directly to a checkout of the source in ~/strapd.
It's exclusively intended for developers working on strapd itself.

WARNING

  gum confirm --default=false "Switch to dev channel?"
}

validate_dev_checkout() {
  local checkout="$1"

  if [[ -e $checkout && ! -d $checkout/.git ]]; then
    fail "$checkout already exists and is not a git checkout."
  fi

  if [[ -d $checkout/.git && ( ! -d $checkout/bin || ! -d $checkout/default || ! -d $checkout/shell ) ]]; then
    fail "$checkout is a git checkout, but it does not look like strapd."
  fi
}

link_dev_checkout() {
  local checkout="$1"
  # TODO: clone strapd here once it has a canonical repo URL. Until then the
  # dev channel needs a checkout you placed yourself, rather than one pulled
  # from whatever org happens to be spelled in this file.
  [[ -d $checkout/.git ]] ||
    fail "no strapd checkout at $checkout. Clone one there first, then re-run."

  strapd-dev-link "$checkout" --no-reboot
}

(( $# > 0 )) || { usage; exit 1; }

dev_checkout=""
channel="$1"
leaving_dev=0

case "$channel" in
  stable)
    pacman_channel=stable
    packages=(strapd strapd-settings)
    ;;
  rc)
    pacman_channel=rc
    packages=(strapd strapd-settings)
    ;;
  edge)
    pacman_channel=edge
    packages=(strapd-dev strapd-settings-dev)
    ;;
  dev)
    confirm_dev || { echo "Cancelled."; exit 0; }
    dev_checkout="$HOME/strapd"
    validate_dev_checkout "$dev_checkout"
    pacman_channel=edge
    packages=(strapd-dev strapd-settings-dev)
    ;;
  *)
    echo "Unknown channel: $channel" >&2
    usage >&2
    exit 1
    ;;
esac

if [[ -z $dev_checkout && $STRAPD_PATH != "/usr/share/strapd" ]]; then
  leaving_dev=1
fi

if [[ -n $dev_checkout ]]; then
  link_dev_checkout "$dev_checkout"
  export STRAPD_PATH="$dev_checkout"
  export PATH="$STRAPD_PATH/bin:$PATH"
  strapd-state set reboot-required
fi

strapd-refresh-pacman "$pacman_channel"
# --ask 4 accepts strapd <-> strapd-dev replacement prompts without file overwrites.
sudo env STRAPD_UPDATE_PACMAN=1 pacman -S --needed --noconfirm --ask 4 "${packages[@]}"

if [[ -z $dev_checkout ]]; then
  strapd-dev-unlink --no-reboot
  export STRAPD_PATH=/usr/share/strapd

  if (( leaving_dev )); then
    strapd-state set reboot-required
  fi
fi

strapd-update -y
