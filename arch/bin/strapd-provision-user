#!/bin/bash

# strapd:summary=Finalize strapd user setup (runtime tweaks /etc/skel can't do)
# strapd:hidden=true

set -euo pipefail

usage() {
  cat <<USAGE
Usage: strapd finalize user [--force] [--first-install]

Runs the per-user setup steps that /etc/skel can't seed:
dev-aware skill symlinks, xdg-user-dirs + gtk bookmarks (need \$HOME),
default browser, and install/user/all.sh.

For shipped configs see /etc/skel (new users) and strapd-reinstall-configs
(existing users explicitly resyncing).

--first-install is used by the ISO in the target chroot.

Idempotency marker: ~/.local/state/strapd/done/finalize-user
USAGE
}

if (( EUID == 0 )); then
  echo "Error: run strapd-provision-user as the user being configured, not as root." >&2
  exit 1
fi

force=0
first_install=0
while (($#)); do
  case "$1" in
    --force)
      force=1
      shift
      ;;
    --first-install)
      first_install=1
      force=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      usage >&2
      exit 1
      ;;
  esac
done

state_dir="$HOME/.local/state/strapd"
mkdir -p "$state_dir"

if strapd-done check finalize-user && (( force == 0 )); then
  echo "User finalization already complete (rerun with --force to refresh)."
  exit 0
fi

export STRAPD_PATH="${STRAPD_PATH:-/usr/share/strapd}"
export STRAPD_INSTALL="${STRAPD_INSTALL:-$STRAPD_PATH/install}"
export STRAPD_SETUP_CONTEXT="${STRAPD_SETUP_CONTEXT:-runtime}"
export PATH="$STRAPD_PATH/bin:$PATH"

if (( first_install )) && [[ $STRAPD_SETUP_CONTEXT == "runtime" ]]; then
  # The ISO chroot doesn't set a context; strapd-provision-owner runs first-install
  # finalization too but with STRAPD_SETUP_CONTEXT=provision-owner already set.
  export STRAPD_SETUP_CONTEXT=iso-chroot
fi

if [[ -n ${STRAPD_INSTALL_LOG_FILE:-} && -f $STRAPD_INSTALL/helpers/logging.sh ]]; then
  source "$STRAPD_INSTALL/helpers/logging.sh"
else
  run_logged() {
    local script="$1"
    bash -eE -c 'source "$1"' bash "$script"
  }
fi

# Dev-aware skill symlinks. Cannot live in /etc/skel because STRAPD_PATH may
# point at a dev checkout where the target differs. Loops every skill directory,
# so shipping a new one needs no edit here.
#
# nullglob because strapd ships no skills yet: without it the unmatched glob
# survives as a literal and every agent directory gets a broken symlink.
mkdir -p ~/.agents/skills ~/.claude/skills ~/.codex/skills ~/.pi/agent/skills ~/.gemini/config/skills
shopt -s nullglob
for skill in "$STRAPD_PATH"/default/agents/skills/*/; do
  skill=${skill%/}
  name=${skill##*/}
  ln -sfn "$skill" ~/.agents/skills/"$name"
  ln -sfn "$skill" ~/.claude/skills/"$name"
  ln -sfn "$skill" ~/.codex/skills/"$name"
  ln -sfn "$skill" ~/.pi/agent/skills/"$name"
  ln -sfn "$skill" ~/.gemini/config/skills/"$name"
done
shopt -u nullglob

mkdir -p ~/Downloads ~/Pictures ~/Videos ~/.config/gtk-3.0
xdg-user-dirs-update --set TEMPLATES "$HOME"
xdg-user-dirs-update --set PUBLICSHARE "$HOME"
xdg-user-dirs-update --set DESKTOP "$HOME"
rmdir ~/Templates ~/Public ~/Desktop 2>/dev/null || true
touch ~/.config/gtk-3.0/bookmarks
for dir in Downloads Projects Pictures Videos; do
  bookmark="file://$HOME/$dir $dir"
  grep -qxF "$bookmark" ~/.config/gtk-3.0/bookmarks || echo "$bookmark" >>~/.config/gtk-3.0/bookmarks
done

source "$STRAPD_INSTALL/user/all.sh"

strapd-refresh-applications
env -u BROWSER xdg-settings set default-web-browser chromium.desktop

strapd-done mark finalize-user
echo "User finalization complete."
