#!/bin/bash

# strapd:summary=Install Heroic Games Launcher (Epic, GOG, Amazon Prime Gaming) with graphics drivers.
# strapd:requires-sudo=true

set -e

echo "Installing Heroic Games Launcher..."
strapd-pkg-add heroic-games-launcher-bin
strapd-install-gaming-gpu-lib32

setsid uwsm-app -- gtk-launch heroic >/dev/null 2>&1 &
