#!/bin/bash

# strapd:summary=Install Helix and configure it to use the current strapd theme

echo "Installing Helix..."
strapd-pkg-add helix

mkdir -p ~/.config/helix/themes

# Symlinked so Helix tracks the active theme.
ln -sf "$HOME/.local/state/strapd/current/theme/helix.toml" ~/.config/helix/themes/strapd.toml

if [[ ! -f ~/.config/helix/config.toml ]]; then
  cat >~/.config/helix/config.toml <<'EOF'
theme = "strapd"
EOF
fi

# For users whose current theme predates this template.
if [[ ! -e $HOME/.local/state/strapd/current/theme/helix.toml ]]; then
  strapd-theme-refresh
fi

# Arch-based distros ship Helix as 'helix' rather than the upstream 'hx'.
if ! grep -q '^alias hx="helix"' ~/.bashrc 2>/dev/null; then
  echo 'alias hx="helix"' >>~/.bashrc
fi
