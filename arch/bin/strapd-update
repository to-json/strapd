#!/bin/bash

# strapd:summary=Update strapd and system packages
# strapd:args=[-y]
# strapd:examples=strapd update | strapd update -y
# strapd:requires-sudo=true

set -e

if [[ -z ${STRAPD_UPDATE_LOGGED:-} ]]; then
  script_command=$(printf '%q ' "$0" "$@")
  exec env STRAPD_UPDATE_LOGGED=1 script -qefc "$script_command" "/tmp/strapd-update.log"
fi

if ! strapd-update-lock held; then
  exec strapd-update-lock run "$0" "$@"
fi

trap 'echo ""; echo -e "\033[0;31mSomething went wrong during the update!\n\nPlease review the output above carefully, correct the error, and retry the update.\n\nIf you need assistance, get help from the community at https://bootstrapd.org/discord\033[0m"' ERR
trap 'strapd-update-stay-awake stop' EXIT

strapd-update-requires-free-space

# -y is a promise not to ask anything. Steps that would need an answer report
# and move on instead of waiting on a prompt nobody is here to give.
[[ ${1:-} != "-y" ]] || export STRAPD_UPDATE_UNATTENDED=1

if [[ ${1:-} == "-y" ]] || strapd-update-confirm; then
  # Before the snapshot: the cache is on the snapshotted subvolume, so pruning
  # after it frees nothing until that snapshot ages out.
  strapd-update-pkg-prune

  # 127 means Snapper is deliberately absent. Any other failure already said
  # what went wrong, and a missing snapshot is not worth blocking an update
  # over, but it must not pass for one either.
  strapd-snapshot create || (($? == 127)) ||
    echo -e "\e[33mContinuing the update without a snapshot.\e[0m" >&2

  strapd-update-stay-awake start

  strapd-update-dev
  strapd-update-keyring

  # Everything below waits on this finishing. An upgrade that stopped takes the
  # update with it rather than running post-update work against what is still on
  # disk.
  strapd-update-system-pkgs
  strapd-hook post-update
  strapd-update-aur-pkgs
  strapd-update-mise
  strapd-update-orphan-pkgs

  strapd-update-analyze-logs
  strapd-update-status

  # Release update-owned inhibitors before offering a reboot. A confirmed
  # reboot can terminate this process before its EXIT trap gets a chance to
  # remove the persistent Stay Awake marker.
  strapd-update-stay-awake stop
  trap - EXIT

  strapd-update-restart
fi
