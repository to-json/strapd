#!/bin/bash

# strapd:summary=List themes that can style the Plymouth boot screen
# strapd:examples=strapd plymouth list

{
  find ~/.config/strapd/themes/ -mindepth 1 -maxdepth 1 \( -type d -o -type l \) -printf '%f\n' 2>/dev/null
  find "$STRAPD_PATH/themes/" -mindepth 1 -maxdepth 1 -type d -printf '%f\n'
} | sort -u | while read -r name; do
  if [[ -f $(strapd-theme-dir "$name")/preview-unlock.png ]]; then
    echo "$name"
  fi
done
