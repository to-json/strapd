#!/bin/bash

# strapd:summary=Install Xbox Cloud Gaming as a web app and launch it.
# strapd:group=install
# strapd:name=gaming xbox-cloud

set -e

echo "Installing Xbox Cloud Gaming..."
strapd-webapp-install "Xbox Cloud Gaming" "https://www.xbox.com/en-US/play" "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/png/xbox.png"

setsid strapd-launch-webapp "https://www.xbox.com/en-US/play" >/dev/null 2>&1 &
