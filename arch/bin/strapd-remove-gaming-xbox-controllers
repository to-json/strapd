#!/bin/bash

# strapd:summary=Remove the xpadneo Xbox controller driver and undo its module/blacklist config.
# strapd:group=remove
# strapd:name=gaming xbox-controllers
# strapd:requires-sudo=true

set -e

strapd-pkg-drop xpadneo-dkms

sudo rm -f /etc/modprobe.d/blacklist-xpad.conf /etc/modules-load.d/xpadneo.conf

echo ""
echo "Xbox controller support removed. Reboot to fully unload xpadneo and restore xpad."
