#!/bin/bash

# strapd:summary=Remove Tailscale and its bar plugin.
# strapd:requires-sudo=true

tailscale down 2>/dev/null || true
systemctl --user disable --now strapd-tailscale-receive.service 2>/dev/null || true
sudo systemctl disable --now tailscaled.service 2>/dev/null || true
strapd-plugin-disable strapd.tailscale
strapd-webapp-remove "Tailscale" 2>/dev/null || true
strapd-pkg-drop tailscale

echo ""
echo "Tailscale has been removed."
