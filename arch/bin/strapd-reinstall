#!/bin/bash

# strapd:summary=Reinstall strapd packages and reset default configs
# strapd:requires-sudo=true

set -e

echo -e "This will reinstall all default strapd packages and reset default configs.\nWarning: user config changes will be overwritten.\n"

if gum confirm "Are you sure you want to reinstall and lose config changes?"; then
  strapd-reinstall-pkgs
  strapd-reinstall-configs

  gum confirm "System has been reinstalled. Reboot?" && strapd-system-reboot
fi
