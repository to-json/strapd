#!/bin/bash

# strapd:summary=Remove Bitwarden and its Chromium extension.
# strapd:requires-sudo=true

EXTENSION_ID="nngceckbapebfimnlniiiahkandclblb"
EXTENSION_FILE="/usr/share/chromium/extensions/$EXTENSION_ID.json"

sudo rm -f "$EXTENSION_FILE"
strapd-pkg-drop bitwarden bitwarden-cli

echo ""
echo "Bitwarden has been removed."
