# Single source of truth for STRAPD_PATH + PATH adjustments. Sourced by:
#   /etc/profile.d/strapd.sh                 (system login shells)
#   /etc/skel/.bashrc                         (interactive shells)
#   /usr/share/uwsm/env.d/10-strapd          (Hyprland session via uwsm)
#   /usr/share/strapd/default/bash/envs      (bash rc chain; SSH/non-login)

# /etc/strapd.conf is written by strapd-dev-link and reset by
# strapd-dev-unlink. When absent, force the packaged default instead of
# preserving a stale inherited value.
if [ -f /etc/strapd.conf ]; then
  . /etc/strapd.conf
  : "${STRAPD_PATH:=/usr/share/strapd}"
else
  STRAPD_PATH=/usr/share/strapd
fi
export STRAPD_PATH

# Only prepend in dev-link mode. On a production install, the binaries are
# already on PATH as /usr/bin/strapd-* via the strapd package, so prepending
# /usr/share/strapd/bin would just be noise.
if [ "$STRAPD_PATH" != /usr/share/strapd ]; then
  case ":$PATH:" in
    *":${STRAPD_PATH%/}/bin:"*) ;;
    *) PATH="${STRAPD_PATH%/}/bin${PATH:+:$PATH}" ;;
  esac
fi

# User-level tool paths, appended so system binaries keep precedence. This is
# what lets login shells (ssh, bash -lc) and the uwsm session find mise-managed
# tools without an interactive rc. Keep these directories in sync with the PAM
# PATH line from install/config/ssh-command-path.sh, which covers SSH commands
# that run no shell setup at all.
case ":$PATH:" in
  *":$HOME/.local/share/mise/shims:"*) ;;
  *) PATH="${PATH:+$PATH:}$HOME/.local/share/mise/shims" ;;
esac
case ":$PATH:" in
  *":$HOME/.local/bin:"*) ;;
  *) PATH="${PATH:+$PATH:}$HOME/.local/bin" ;;
esac
export PATH
