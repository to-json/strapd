#!/bin/bash

# strapd:summary=Send the low battery warning notification and run battery-low hooks.
# strapd:args=<percentage>
# strapd:hidden=true

set -euo pipefail

if (($# != 1)); then
  echo "Usage: strapd-battery-low <percentage>" >&2
  exit 1
fi

level=$1

strapd-notification-send -g 󱐋 -u critical "Time to recharge!" "Battery is down to ${level}%" -i battery-caution -t 30000
strapd-hook battery-low "$level"
