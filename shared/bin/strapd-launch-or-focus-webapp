#!/bin/bash

# strapd:summary=Launch or focus on a given web app identified by the window-pattern.
# strapd:args=<window-pattern> <url-and-flags...>

if (($# == 0)); then
  echo "Usage: strapd-launch-or-focus-webapp [window-pattern] [url-and-flags...]"
  exit 1
fi

WINDOW_PATTERN="$1"
shift
LAUNCH_COMMAND="strapd-launch-webapp $@"

exec strapd-launch-or-focus "$WINDOW_PATTERN" "$LAUNCH_COMMAND"
