#!/bin/bash

# strapd:summary=Share clipboard, files, or folders with LocalSend
# strapd:group=share
# strapd:name=
# strapd:args=<clipboard|file|folder> [path...]
# strapd:examples=strapd share clipboard | strapd share file ~/Downloads/example.txt

if (($# == 0)); then
  echo "Usage: strapd-menu-share [clipboard|file|folder]"
  exit 1
fi

MODE="$1"
shift

if [[ $MODE == "clipboard" ]]; then
  TEMP_FILE=$(mktemp --suffix=.txt)
  wl-paste >"$TEMP_FILE"
  FILE_ARRAY=("$TEMP_FILE")
elif (($# > 0)); then
  FILE_ARRAY=("$@")
else
  if [[ $MODE == "folder" ]]; then
    select_args=(--title "Share folder" --directory)
  else
    select_args=(--title "Share files" --multiple)
  fi

  # Command substitution so the chooser's exit status survives: reading it
  # through a process substitution reports success for a chooser that never
  # opened, which is indistinguishable here from someone deciding not to share.
  picked=$(strapd-file-select "${select_args[@]}") || status=$?

  if ((${status:-0} > 1)); then
    strapd-notification-send -g "" -u critical "Could not share" "The file chooser did not open"
    exit 1
  fi

  [[ -n $picked ]] || exit 0
  readarray -t FILE_ARRAY <<<"$picked"
fi

systemd-run --user --quiet --collect localsend --headless send "${FILE_ARRAY[@]}"

# The temporary file stays until system cleanup in clipboard mode, so its
# content is still there for the LocalSend GUI.

exit 0
