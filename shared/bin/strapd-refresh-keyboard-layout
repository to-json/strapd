#!/bin/bash
# strapd:summary=Regenerate each compositor's keyboard layout from /etc/vconsole.conf
# strapd:examples=strapd refresh keyboard layout

set -euo pipefail

# /etc/vconsole.conf is where the layout the user picked at install lives. A
# compositor config is static text and cannot read it, so this is the step that
# carries that choice into all three; without it every session comes up us.
vconsole_conf="${STRAPD_VCONSOLE_CONF:-/etc/vconsole.conf}"

layout=""
variant=""

if [[ -f $vconsole_conf ]]; then
  # A systemd env file, sourced the way etc/mkinitcpio.conf.d/strapd_hooks.conf
  # reads it. In a subshell, so KEYMAP and FONT stay out of this script.
  IFS=$'\t' read -r layout variant < <(
    # shellcheck disable=SC1090
    . "$vconsole_conf"
    printf '%s\t%s\n' "${XKBLAYOUT:-}" "${XKBVARIANT:-}"
  )
fi

layout="${layout:-us}"

# CapsLock is the compose key, so Caps Lock itself has to live somewhere else.
# Both Shifts is the usual home but is easy to hit by accident; the _cancel
# variant releases it on the next lone Shift, so a misfire clears itself.
options="compose:caps,shift:both_capslock_cancel"

# Every compositor resolves a keybinding against the first layout in the list,
# not the active one, so strapd's Latin-keysym bindings only fire when a Latin
# layout leads. Same list as etc/mkinitcpio.conf.d/strapd_hooks.conf, which asks
# the same question for the LUKS prompt; keep the two in sync.
case "${layout%%,*}" in
  af | am | ara | bd | bg | by | et | ge | gr | il | in | iq | ir | kg | kh | kz | la | lk | mk | mm | mn | mv | np | rs | ru | sy | th | tj | ua)
    layout="us,$layout"
    variant=",$variant"
    # Reach the original layout with Left Alt + Right Alt.
    options="$options,grp:alts_toggle"
    ;;
esac

out_dir="$HOME/.local/state/strapd/keyboard"

# The list has to match strapd-keybindings-generate's -- a compositor strapd
# binds keys for but never gives a layout to comes up us and unusable on a
# non-Latin install -- so it is checked against that one below.
declare -A OUTPUT_FILE=(
  [niri]=niri.kdl
  [sway]=sway.conf
  [mango]=mango.conf
)

mapfile -t backends < <(strapd-keybindings-generate --list-backends)

for backend in "${backends[@]}"; do
  [[ -n ${OUTPUT_FILE[$backend]:-} ]] && continue
  echo "strapd-refresh-keyboard-layout: strapd-keybindings-generate knows backend '$backend' but this script emits no keyboard layout for it" >&2
  exit 1
done

if (( ${#backends[@]} != ${#OUTPUT_FILE[@]} )); then
  echo "strapd-refresh-keyboard-layout: this script emits ${#OUTPUT_FILE[@]} backends but strapd-keybindings-generate knows ${#backends[@]}" >&2
  exit 1
fi

header() {
  local comment="$1"

  cat <<HEADER
$comment Generated by strapd-refresh-keyboard-layout from /etc/vconsole.conf.
$comment
$comment Do not edit. Every run of this command overwrites the file. Change the
$comment layout with localectl, which rewrites that file, and then run:
$comment
$comment   strapd refresh keyboard layout

HEADER
}

emit_niri() {
  header "//"

  printf 'input {\n    keyboard {\n        xkb {\n'
  printf '            layout "%s"\n' "$layout"
  if [[ -n $variant ]]; then
    printf '            variant "%s"\n' "$variant"
  fi
  printf '            options "%s"\n' "$options"
  printf '        }\n    }\n}\n'
}

emit_sway() {
  header "#"

  printf 'input type:keyboard {\n'
  printf '    xkb_layout "%s"\n' "$layout"
  if [[ -n $variant ]]; then
    printf '    xkb_variant "%s"\n' "$variant"
  fi
  printf '    xkb_options "%s"\n' "$options"
  printf '}\n'
}

emit_mango() {
  header "#"

  printf 'xkb_rules_layout=%s\n' "$layout"
  if [[ -n $variant ]]; then
    printf 'xkb_rules_variant=%s\n' "$variant"
  fi
  printf 'xkb_rules_options=%s\n' "$options"
}

mkdir -p "$out_dir"

# Written beside the file it replaces and moved into place, so the move is a
# same-filesystem rename: niri watches its includes, and a half-written file is
# a config error on screen.
for backend in "${backends[@]}"; do
  staged="$out_dir/.${OUTPUT_FILE[$backend]}.new"
  "emit_$backend" >"$staged"
  mv "$staged" "$out_dir/${OUTPUT_FILE[$backend]}"
done
