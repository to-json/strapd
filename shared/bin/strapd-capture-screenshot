#!/bin/bash

# strapd:summary=Take a screenshot
# strapd:group=capture
# strapd:args=[smart|region|windows|fullscreen] [slurp|copy|save] [--editor=<name>]
# strapd:examples=strapd screenshot | strapd capture screenshot region
# strapd:aliases=strapd screenshot

[[ -f ~/.config/user-dirs.dirs ]] && source ~/.config/user-dirs.dirs
OUTPUT_DIR="${STRAPD_SCREENSHOT_DIR:-${XDG_PICTURES_DIR:-$HOME/Pictures}}"

if [[ ! -d $OUTPUT_DIR ]]; then
  mkdir -p "$OUTPUT_DIR"
  strapd-notification-send "Created screenshot directory: $OUTPUT_DIR" -t 2000
fi

# A second press while the picker is open cancels it rather than stacking a
# second one. Scoped to this user: pkill searches the whole process table, and
# on a machine with two sessions logged in an unscoped kill cancels someone
# else's screenshot.
pkill -u "$(id -u)" slurp && exit 0

SCREENSHOT_EDITOR="${STRAPD_SCREENSHOT_EDITOR:-tensaku-edit}"

ARGS=()
for arg in "$@"; do
  if [[ $arg == --editor=* ]]; then
    SCREENSHOT_EDITOR="${arg#--editor=}"
  else
    ARGS+=("$arg")
  fi
done
set -- "${ARGS[@]}"

MODE="${1:-smart}"
PROCESSING="${2:-slurp}"

# The picker leaves the screen freeze running (PID on its first output line) so
# grim captures the frozen overlay rather than content shifting during teardown.
cleanup() {
  [[ -n ${FREEZE_PID:-} ]] && kill $FREEZE_PID 2>/dev/null
}
trap cleanup EXIT

{ read -r FREEZE_PID; read -r SELECTION; } < <(strapd-capture-region "$MODE" --keep-freeze)

[[ -z ${SELECTION:-} ]] && exit 0

FILENAME="screenshot-$(date +'%Y-%m-%d_%H-%M-%S').png"
FILEPATH="$OUTPUT_DIR/$FILENAME"

case "$PROCESSING" in
  slurp)
    grim -g "$SELECTION" "$FILEPATH" || exit 1
    echo "$FILEPATH"
    wl-copy --type image/png <"$FILEPATH"

    # Best-effort: the screenshot is already saved and on the clipboard, so a
    # notification outage must not report the capture itself as failed.
    strapd-notification-send "Screenshot saved to clipboard and file" "Edit with Super + Alt + , (or click this)" \
      --image "$FILEPATH" \
      --exec "$SCREENSHOT_EDITOR" "$FILEPATH" || true
    ;;
  copy)
    grim -g "$SELECTION" - | wl-copy --type image/png
    ;;
  save)
    grim -g "$SELECTION" "$FILEPATH" || exit 1
    echo "$FILEPATH"
    ;;
esac
