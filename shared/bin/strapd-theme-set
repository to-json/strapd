#!/bin/bash

# strapd:summary=Apply a strapd theme
# strapd:args=<theme-name>
# strapd:examples=strapd theme list | strapd theme set "Everforest"

# Stages the theme, generates its templates and swaps them in atomically.
#
# It does not reload the compositor: the three compositor configs carry
# Everforest spelled out, so nothing on that side changes when the theme does.
# Templating those configs is what would make a reload belong here.

if [[ -z $1 ]]; then
  echo "Usage: strapd-theme-set <theme-name>"
  exit 1
fi

CURRENT_THEME_PATH="$HOME/.local/state/strapd/current/theme"
NEXT_THEME_PATH="$HOME/.local/state/strapd/current/next-theme"
CURRENT_BACKGROUND_LINK="$HOME/.local/state/strapd/current/background"
THEME_SET_LOCK="${XDG_RUNTIME_DIR:-/tmp}/strapd-theme-set.lock"
USER_THEMES_PATH="$HOME/.config/strapd/themes"
STRAPD_THEMES_PATH="$STRAPD_PATH/themes"

# What a theme installed from a git repo may not ship, because these run code.
# Neovim loads a theme's neovim.lua at startup and gum_env.lua is sourced by the
# shell, so no .lua from such a theme is staged at all. Each terminal config
# names the program the terminal launches, and vscode.json names an extension,
# a VS Code extension being arbitrary JavaScript. Everything else is colour.
#
# Adding a template for another terminal, or another editor that loads Lua,
# means adding it here.
INSTALLED_THEME_DENIED=(alacritty.toml foot.ini ghostty.conf kitty.conf vscode.json)
IGNORED_THEME_FILES=()

run_parallel() {
  local pid
  local pids=()

  for command in "$@"; do
    bash -lc "$command" &
    pids+=("$!")
  done

  for pid in "${pids[@]}"; do
    wait "$pid"
  done
}

choose_theme_background() {
  local backgrounds=()
  local current_background index next_index i

  CHOSEN_THEME_BACKGROUND=""
  mapfile -d '' -t backgrounds < <(
    find -L "$HOME/.config/strapd/backgrounds/$THEME_NAME/" "$CURRENT_THEME_PATH/backgrounds/" -maxdepth 1 -type f \
      \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.gif' -o -iname '*.bmp' -o -iname '*.webp' \) \
      -print0 2>/dev/null | sort -z
  )

  (( ${#backgrounds[@]} > 0 )) || return 1

  current_background=$(readlink "$CURRENT_BACKGROUND_LINK" 2>/dev/null || true)
  index=-1
  for i in "${!backgrounds[@]}"; do
    if [[ ${backgrounds[$i]} == "$current_background" ]]; then
      index=$i
      break
    fi
  done

  if (( index == -1 )); then
    CHOSEN_THEME_BACKGROUND="${backgrounds[0]}"
  else
    next_index=$(((index + 1) % ${#backgrounds[@]}))
    CHOSEN_THEME_BACKGROUND="${backgrounds[$next_index]}"
  fi
}

set_theme_background_link() {
  choose_theme_background || return 1
  ln -nsf "$CHOSEN_THEME_BACKGROUND" "$CURRENT_BACKGROUND_LINK"
}

is_denied_installed_file() {
  local name="$1"
  local denied

  [[ $name == *.lua ]] && return 0

  for denied in "${INSTALLED_THEME_DENIED[@]}"; do
    [[ $name == "$denied" ]] && return 0
  done

  return 1
}

# Themes older than colors.toml still get their palette, but their
# alacritty.toml never reaches the staged theme: it names the program the
# terminal launches.
stage_installed_colors_from_alacritty() {
  local source="$1"
  local scratch

  if [[ -f $NEXT_THEME_PATH/colors.toml ]]; then
    return
  fi

  if [[ ! -f $source/alacritty.toml || -L $source/alacritty.toml ]]; then
    return
  fi

  scratch=$(mktemp -d)
  cp "$source/alacritty.toml" "$scratch/alacritty.toml"
  strapd-theme-colors-from-alacritty "$scratch"

  if [[ -f $scratch/colors.toml ]]; then
    cp "$scratch/colors.toml" "$NEXT_THEME_PATH/colors.toml"
  fi

  rm -rf "$scratch"
}

# Copies a directory without ever following a symlink: in an installed theme one
# points wherever the theme author chose, which is how an unlock.png becomes a
# copy of any file the session can read.
stage_installed_dir() {
  local source="$1"
  local dest="$2"
  local entry name

  mkdir -p "$dest"

  for entry in "$source"/*; do
    [[ -e $entry && ! -L $entry ]] || continue
    name=${entry##*/}

    if [[ -d $entry ]]; then
      stage_installed_dir "$entry" "$dest/$name"
    else
      cp "$entry" "$dest/$name"
    fi
  done
}

# `strapd theme install` clones into ~/.config/strapd/themes, so a .git
# directory there means the contents came from a stranger and are held to the
# list above. A directory the user wrote themselves is theirs to fill.
theme_came_from_a_repo() {
  local source="$1"

  [[ ! -L $source && -d $source/.git ]]
}

stage_installed_theme() {
  local source="$1"
  local entry name

  [[ -d $source ]] || return 0

  for entry in "$source"/*; do
    [[ -e $entry ]] || continue
    name=${entry##*/}

    if [[ -L $entry ]] || is_denied_installed_file "$name"; then
      case "${name,,}" in
        readme* | license* | changelog* | *.md | *.txt) ;;
        *) IGNORED_THEME_FILES+=("$name") ;;
      esac
    elif [[ -d $entry ]]; then
      stage_installed_dir "$entry" "$NEXT_THEME_PATH/$name"
    else
      cp "$entry" "$NEXT_THEME_PATH/$name"
    fi
  done

  stage_installed_colors_from_alacritty "$source"
}

report_ignored_theme_files() {
  (( ${#IGNORED_THEME_FILES[@]} > 0 )) || return 0

  echo "Ignored in $USER_THEMES_PATH/$THEME_NAME: ${IGNORED_THEME_FILES[*]}" >&2
  echo "A theme installed from a git repo cannot supply Lua, a terminal config, or vscode.json." >&2
}

THEME_NAME=$(echo "$1" | sed -E 's/<[^>]+>//g' | tr '[:upper:]' '[:lower:]' | tr ' ' '-')
THEME_HEADLESS=0
if [[ ${STRAPD_THEME_HEADLESS:-} == "1" || ${STRAPD_THEME_OFFLINE:-} == "1" ]]; then
  THEME_HEADLESS=1
fi

if [[ -z $THEME_NAME || $THEME_NAME == .* || $THEME_NAME == */* ]]; then
  echo "Invalid theme name: $1"
  exit 1
fi

if [[ ! -d $STRAPD_THEMES_PATH/$THEME_NAME ]] && [[ ! -d $USER_THEMES_PATH/$THEME_NAME ]]; then
  echo "Theme '$THEME_NAME' does not exist"
  exit 1
fi

# Theme switching rebuilds a shared staging directory and updates the current
# symlinks; concurrent calls otherwise race and one selection appears ignored.
exec 9>"$THEME_SET_LOCK"
flock 9

rm -rf "$NEXT_THEME_PATH"
mkdir -p "$NEXT_THEME_PATH"

# Official theme first, then the user's on top.
cp -r "$STRAPD_THEMES_PATH/$THEME_NAME/"* "$NEXT_THEME_PATH/" 2>/dev/null

if theme_came_from_a_repo "$USER_THEMES_PATH/$THEME_NAME"; then
  stage_installed_theme "$USER_THEMES_PATH/$THEME_NAME"
  report_ignored_theme_files
else
  cp -r "$USER_THEMES_PATH/$THEME_NAME/"* "$NEXT_THEME_PATH/" 2>/dev/null
fi

if [[ ! -f $NEXT_THEME_PATH/colors.toml && -f $NEXT_THEME_PATH/alacritty.toml ]]; then
  strapd-theme-colors-from-alacritty "$NEXT_THEME_PATH"
fi

strapd-theme-set-templates

rm -rf "$CURRENT_THEME_PATH"
mv "$NEXT_THEME_PATH" "$CURRENT_THEME_PATH"

echo "$THEME_NAME" >"$HOME/.local/state/strapd/current/theme.name"

# --skip-background is how strapd-theme-refresh re-renders templates without
# advancing the rotation.
if [[ ${STRAPD_THEME_SKIP_BACKGROUND:-} != "1" ]]; then
  set_theme_background_link || true
fi

# Headless is the ISO chroot, where skipping this keeps the finalize step from
# depending on a Wayland display at all.
if [[ $THEME_HEADLESS != "1" ]]; then
  strapd-theme-bg-apply >/dev/null 2>&1 || true
fi

# The critical section ends here: let another theme selection queue behind that
# rather than behind slower app-retint hooks and cache warmups.
flock -u 9

post_theme_commands=(
  strapd-restart-terminal
  strapd-restart-btop
  strapd-restart-opencode
  strapd-restart-helix
  strapd-theme-set-foot
  strapd-theme-set-tmux
  strapd-theme-set-gnome
  strapd-theme-set-pi
  strapd-theme-set-claude
  strapd-theme-set-browser
  strapd-theme-set-vscode
  strapd-theme-set-obsidian
  strapd-theme-set-keyboard
)

if [[ $THEME_HEADLESS != "1" ]]; then
  run_parallel "${post_theme_commands[@]}"

  strapd-hook theme-set "$THEME_NAME" >/dev/null

  strapd-theme-switcher --preload >/dev/null 2>&1
  strapd-theme-bg-cache >/dev/null 2>&1 &
fi
