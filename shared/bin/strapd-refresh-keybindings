#!/bin/bash
# strapd:summary=Regenerate every compositor's keybinding config from the keybinding TOML
# strapd:examples=strapd refresh keybindings

set -euo pipefail

STRAPD_PATH="${STRAPD_PATH:-/usr/share/strapd}"

# The TOML the user edits wins over the one strapd ships, so an update can
# improve the defaults for everyone who has not taken the file over.
user_toml="$HOME/.config/strapd/keybindings.toml"
default_toml="$STRAPD_PATH/keybindings/actions.toml"

if [[ -f $user_toml ]]; then
  source_toml="$user_toml"
else
  source_toml="$default_toml"
fi

# Generated output is state, not config. Keeping it out of ~/.config is what
# lets the compositor configs there stay hand-editable files an update never
# has to touch.
out_dir="$HOME/.local/state/strapd/keybindings"

# The backend *list* comes from the generator below, not from here. A backend
# the generator knows and this table does not is a hard error, not a skip.
declare -A OUTPUT_FILE=(
  [niri]=niri.kdl
  [sway]=sway.conf
  [mango]=mango.conf
)
declare -A COMMENT=(
  [niri]="//"
  [sway]="#"
  [mango]="#"
)

if [[ ! -f $source_toml ]]; then
  echo "strapd-refresh-keybindings: no keybinding table at $source_toml" >&2
  exit 1
fi

mapfile -t backends < <(strapd-keybindings-generate --list-backends)

for backend in "${backends[@]}"; do
  [[ -n ${OUTPUT_FILE[$backend]:-} && -n ${COMMENT[$backend]:-} ]] && continue
  echo "strapd-refresh-keybindings: strapd-keybindings-generate knows backend '$backend' but this script has no output file for it; add it to OUTPUT_FILE and COMMENT" >&2
  exit 1
done

header() {
  local comment="$1"

  cat <<HEADER
$comment Generated by strapd-refresh-keybindings from $source_toml.
$comment
$comment Do not edit. Every run of this command overwrites the file. Edit the
$comment table it came from instead. Copy $default_toml
$comment to $user_toml if you have not already, and then run:
$comment
$comment   strapd refresh keybindings

HEADER
}

mkdir -p "$out_dir"

# Render every backend before moving any into place: a TOML that fails
# validation should leave the last good configs untouched rather than
# half-replace them, while the compositor reading them is running. Staging
# inside $out_dir keeps each move a same-filesystem rename, and niri watches its
# include files, so it can and will read a file mid-write.
staging=$(mktemp -d "$out_dir/.staging.XXXXXX")
trap 'rm -rf "$staging"' EXIT

for backend in "${backends[@]}"; do
  header "${COMMENT[$backend]}" >"$staging/${OUTPUT_FILE[$backend]}"
  strapd-keybindings-generate "$source_toml" --backend "$backend" >>"$staging/${OUTPUT_FILE[$backend]}"
done

for backend in "${backends[@]}"; do
  mv "$staging/${OUTPUT_FILE[$backend]}" "$out_dir/${OUTPUT_FILE[$backend]}"
done
