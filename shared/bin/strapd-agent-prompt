#!/bin/bash

# strapd:summary=Launch the default coding agent with a prompt
# strapd:args=[--inline] <prompt...>
# strapd:examples=strapd agent prompt "Review this project"

# Prompts live here rather than on `strapd agent`, where a bare prompt would
# shadow the subcommands under that group.

set -euo pipefail

inline=()
if [[ ${1:-} == "--inline" ]]; then
  inline=(--inline)
  shift
fi

if (($# == 0)); then
  echo "Usage: strapd agent prompt [--inline] <prompt...>" >&2
  exit 1
fi

exec strapd-agent "${inline[@]}" --prompt "$*"
