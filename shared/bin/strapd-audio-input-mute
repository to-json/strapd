#!/bin/bash

# strapd:summary=Toggle microphone mute. Drives the hardware mic-mute LED on laptops that expose one.

wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle >/dev/null

if wpctl get-volume @DEFAULT_AUDIO_SOURCE@ | grep -q MUTED; then
  strapd-brightness-keyboard-mute on
  strapd-osd -i microphone-muted -m "Microphone muted"
else
  strapd-brightness-keyboard-mute off
  strapd-osd -i microphone -m "Microphone on"
fi
